#! /bin/bash
echo build.cmake >> .last-build
# load the PREFIX variables
# specific to your site
. local-install-list
# make sure 'module' exists; comment out if you remove
# the module commands below and set your own environment
# variables needed to get c++17.
. local-check-module
if test -z "$BLT_SRC"; then
	BLT_SRC=$(pwd)/../blt
fi
if test -z "$ADC_PREFIX"; then
	ADC_PREFIX=$(pwd)/inst-glh
fi

module purge
module load aue/zlib/1.3
module load aue/intel-oneapi-mkl/2024.2.2
module load aue/binutils/2.45 
module load aue/hdf5/1.14.3-oneapi-2024.2.1-intel-oneapi-mpi-2021.13.1
module load aue/cmake/4.1.2 
module load aue/parallel-netcdf/1.12.3-oneapi-2024.2.1-intel-oneapi-mpi-2021.13.1
module load aue/git/2.48.1 
module load aue/netcdf-c/4.9.2-oneapi-2024.2.1-intel-oneapi-mpi-2021.13.1
module load aue/git-lfs/3.7.0 
module load aue/boost/1.86.0-oneapi-2024.2.1-intel-oneapi-mpi-2021.13.1
module load aue/ninja/1.12.0 
module load aue/yaml-cpp/0.7.0
module load aue/intel-oneapi-compilers/2024.2.1
module load aue/intel-oneapi-mpi/2021.13.1

mkdir -p cbuild.glh
cd cbuild.glh
echo "cmake at: $(which cmake)"
echo "g++ at: $(which g++)"
echo "ltdl at: $(which ltdl)"
echo "libtool at: $(which libtool)"
echo "ld at: $(which ld)"
cmake -DBLT_SOURCE_DIR=$BLT_SRC \
	-DBUILD_SHARED_LIBS=On \
	-DENABLE_MPI=On \
	-DENABLE_DOC=On \
	-DCMAKE_INSTALL_PREFIX=$ADC_PREFIX \
	-DCFLAGS="-g" \
	-DCMAKE_BUILD_TYPE=Debug \
	-DENABLE_GTEST=Off \
       	..
VERBOSE=1 make && make install && make doc
